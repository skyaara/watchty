{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "watchty hook"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "watchty hook"
      }
    ],
    "preToolUse": [
      {
        "command": "watchty hook",
        "matcher": "Shell"
      }
    ],
    "postToolUse": [
      {
        "command": "watchty hook",
        "matcher": "Shell"
      }
    ],
    "postToolUseFailure": [
      {
        "command": "watchty hook",
        "matcher": "Shell"
      }
    ],
    "sessionEnd": [
      {
        "command": "watchty hook"
      }
    ]
  }
}
